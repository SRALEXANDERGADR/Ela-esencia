{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ela-esencia",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // "demo" = web de muestra (el plan se escoge con ?plan=basico|profesional|completo).
    // Para una web ya vendida: "basico", "profesional" o "completo" (plan fijo).
    "PLAN": "demo",
    "GITHUB_BRANCH": "main",
    "GITHUB_UPLOAD_PATH": "public/uploads"
  },
  // Fotos nuevas de productos y servicios (ver src/lib/fotos.ts). El bucket
  // tiene que existir en la cuenta de Cloudflare antes de publicar.
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "ela-esencia-fotos" }],
  // Toca la base de datos cada 12 horas para que Neon no la archive (ver src/server.ts).
  "triggers": { "crons": ["0 */12 * * *"] },
  "observability": {
    "enabled": true
  }
}
