# Copia este archivo a .dev.vars (NO lo subas a git) para desarrollo local.
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require
ADMIN_PASSWORD=cambia-esto
SESSION_SECRET=una-cadena-larga-y-aleatoria

# Subida de imágenes a GitHub (opcional pero recomendado)
GITHUB_TOKEN=
GITHUB_REPO=usuario/repositorio
GITHUB_BRANCH=main
GITHUB_UPLOAD_PATH=public/uploads

# Aviso por correo de nuevos pedidos y citas (opcional, vía Resend https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ELA <onboarding@resend.dev>
